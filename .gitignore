# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Flutter/flutter_export_environment.sh
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android
/android/.gradle/
/android/.kotlin/
/android/captures/
/android/gradlew
/android/gradlew.bat
/android/gradle/wrapper/gradle-wrapper.jar
/android/local.properties
/android/**/GeneratedPluginRegistrant.java
/android/key.properties
*.jks

# iOS/XCode
/ios/.generated/
/ios/.symlinks/
/ios/Flutter/App.framework
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Flutter/app.flx
/ios/Flutter/app.zip
/ios/Flutter/flutter_assets/
/ios/Pods/
/ios/ServiceDefinitions.json
/ios/Runner/GeneratedPluginRegistrant.*
/ios/Packages/SwiftGodotCompatible/.build/
/ios/Packages/SwiftGodotCompatible/.swiftpm/

# macOS
/macos/Flutter/ephemeral/
/macos/Pods/

# Windows
/windows/flutter/ephemeral/

# Linux
/linux/flutter/ephemeral/

# Web
/web/.dart_tool/

# Exceptions to above rules
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# Environment files
.env
.env.*
*.env

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart
/godot_3d/.godot/

# Test coverage
coverage/
*.lcov

# FVM (Flutter Version Management)
.fvm/

# Local Godot exporter binaries used by tool/export_godot_*_pack.sh
.tools/

# Manual device/simulator QA captures and drive helpers
qa_shots/

# Generated QA images (keep existing tracked evidence and test source).
/qa_evidence/**/*.png
/test/failures/

# Local device captures and resized store screenshots. Keep the curated
# store icon/feature artwork and previously tracked listing images.
/store_assets/*/ios-ipad*/
/store_assets/*/ios-iphone*/
/store_assets/*/google-play-phone/
/store_assets/*/google-play-tablet/

# Raw Instruments traces stay on local disk; summarized exports are committed.
qa_evidence/**/*.trace/
qa_evidence/**/*.trace
